{
  "name": "gears",
  "private": true,
  "version": "0.0.0",
  "description": "檔案工作台 anoni.net Gears",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/copy-vendor.mjs && node scripts/make-qr-samples.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-vendor.mjs && node scripts/make-qr-samples.mjs",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:onion": "playwright test -c playwright.onion.config.ts",
    "test:unit": "playwright test --project=unit",
    "build:server": "vite build -c vite.server.config.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@noble/hashes": "2.4.0",
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "age-encryption": "0.3.1",
    "jsqr": "1.4.0",
    "libheif-js": "1.23.5",
    "onnxruntime-web": "1.30.0",
    "opencc-js": "1.4.2",
    "openpgp": "6.3.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "preact": "11.0.1",
    "qrcode-generator": "2.0.4",
    "tesseract.js": "7.0.0",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "ws": "8.22.0"
  }
}
